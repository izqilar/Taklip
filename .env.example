# H5 在线设计平台 — 环境变量样例
# 复制为 .env 并填写真实值（切勿提交真实密钥到仓库）
# 生产部署时由 docker-compose.prod.yml 读取

# ---- 数据库 ----
POSTGRES_USER=h5design
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=h5design_platform

# ---- 后端认证与运行 ----
JWT_SECRET=please_generate_a_long_random_secret
JWT_REFRESH_SECRET=please_generate_another_long_random_secret
JWT_EXPIRES_IN=7200
JWT_REFRESH_EXPIRES_IN=604800
PORT=3000

# ---- 对象存储（腾讯云 COS，发布静态包可选；不填则仍可用本地/数据库方案） ----
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=

# ---- 监控（可选，Sentry 接入点占位，见 apps/server/src/observability/sentry.config.example.ts） ----
SENTRY_DSN=

# ---- Redis（当前应用代码未接入，预留） ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
