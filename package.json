{
  "name": "h5design",
  "version": "0.1.0",
  "private": true,
  "description": "请柬云在线设计平台 monorepo 脚手架",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n web,server -c blue,green \"pnpm --filter @h5design/web dev\" \"pnpm --filter @h5design/server start:dev\"",
    "dev:safe": "concurrently -n web,server -c blue,green \"pnpm --filter @h5design/web dev\" \"pnpm --filter @h5design/server dev:compiled\"",
    "dev:web": "pnpm --filter @h5design/web dev",
    "dev:server": "pnpm --filter @h5design/server start:dev",
    "build": "pnpm --filter @h5design/core build && pnpm --filter @h5design/web build && pnpm --filter @h5design/server build",
    "core:build": "pnpm --filter @h5design/core build",
    "typecheck": "pnpm -r typecheck",
    "prisma:generate": "pnpm --filter @h5design/server prisma:generate",
    "prisma:migrate": "pnpm --filter @h5design/server prisma:migrate"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@prisma/client",
      "prisma",
      "@prisma/engines",
      "@nestjs/core",
      "bcrypt"
    ]
  }
}
